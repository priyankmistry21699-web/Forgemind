# ============================================================
# ForgeMind — Production Environment Variables
# ============================================================
# Copy to .env in the project root before running:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# REQUIRED variables are marked with [REQUIRED].
# Generate secrets with: openssl rand -hex 32
# ============================================================

# ── General ──────────────────────────────────────────────────
APP_ENV=production
DEBUG=false

# [REQUIRED] Random secret for JWT signing — MUST be changed
SECRET_KEY=

# ── Database ─────────────────────────────────────────────────
POSTGRES_DB=forgemind
POSTGRES_USER=forgemind
# [REQUIRED] Strong database password
POSTGRES_PASSWORD=

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── CORS / URLs ──────────────────────────────────────────────
# [REQUIRED] Your production domain (comma-separated for multiple)
CORS_ORIGINS=https://forgemind.example.com
# [REQUIRED] Public URL the frontend uses to reach the API
NEXT_PUBLIC_API_URL=https://forgemind.example.com

# ── API Tuning ───────────────────────────────────────────────
API_WORKERS=2

# ── Worker ───────────────────────────────────────────────────
WORKER_POLL_INTERVAL=5
WORKER_MAX_TASKS_PER_CYCLE=3

# ── LLM Keys (at least one recommended) ─────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Nginx Ports ──────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
